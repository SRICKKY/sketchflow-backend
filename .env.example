# Postgres connection (same schema style as the SketchFlow Next.js app)
DATABASE_URL=postgres://sketchflow:sketchflow@localhost:5432/sketchflow

# Optional shared collaboration fan-out (rediss:// enables TLS).
# Keep credentials in deployment secrets; never commit the connection URL.
REDIS_URL=

# HTTP server
HOST=0.0.0.0
PORT=8080

# JWT session signing secret (use a long random value in production)
JWT_SECRET=change-me-dev-secret
JWT_SESSION_DAYS=30

# CORS origin(s) allowed to call this API (comma-separated)
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Local fallback for uploaded assets when S3_BUCKET is not configured
ASSET_STORAGE_DIR=./uploads

# S3-compatible asset storage (Silo for local development)
S3_BUCKET=sketchflow-assets
S3_REGION=us-east-1
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY_ID=sketchflow
S3_SECRET_ACCESS_KEY=local-silo-development-only
S3_SESSION_TOKEN=

# Razorpay (payments)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Payment gateway: razorpay (default) or paddle. Cashfree is not implemented
# in this backend.
PAYMENT_GATEWAY=razorpay

# Paddle (set PAYMENT_GATEWAY=paddle to use Paddle checkout)
PADDLE_ENV=sandbox
PADDLE_API_KEY=
PADDLE_CLIENT_TOKEN=
PADDLE_WEBHOOK_SECRET=
PADDLE_PRICE_ID_MONTHLY=
PADDLE_PRICE_ID_YEARLY=

# Billing plan pricing (in smallest currency unit, e.g. paise)
PLAN_PRICE_MONTH_MINOR=50000
PLAN_PRICE_YEAR_MINOR=500000
CHECKOUT_CURRENCY=INR

# Public base URL of this API (used to build asset URLs)
PUBLIC_BASE_URL=http://localhost:8080
